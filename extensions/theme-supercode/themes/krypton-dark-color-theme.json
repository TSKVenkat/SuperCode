    "tokenColors": [
        {
            "settings": {
                "foreground": "#E8F0FF"
            }
        },
        {
            "name": "Comment",
            "scope": "comment",
            "settings": {
                "fontStyle": "italic",
                "foreground": "#4A6A9A"
            }
        },
        {
            "name": "Keyword",
            "scope": [
                "keyword",
                "storage.type",
                "storage.modifier"
            ],
            "settings": {
                "foreground": "#CC0000",
                "fontStyle": "bold"
            }
        },
        {
            "name": "Operator",
            "scope": "keyword.operator",
            "settings": {
                "foreground": "#FFD700"
            }
        },
        {
            "name": "String",
            "scope": "string",
            "settings": {
                "foreground": "#88CC88"
            }
        },
        {
            "name": "String Escape",
            "scope": [
                "constant.character.escape",
                "string constant"
            ],
            "settings": {
                "foreground": "#AAFFAA"
            }
        },
        {
            "name": "Number",
            "scope": [
                "constant.numeric",
                "constant.language"
            ],
            "settings": {
                "foreground": "#FFD700"
            }
        },
        {
            "name": "Constant",
            "scope": "constant",
            "settings": {
                "foreground": "#FF8844"
            }
        },
        {
            "name": "Variable",
            "scope": [
                "variable",
                "variable.other"
            ],
            "settings": {
                "foreground": "#E8F0FF"
            }
        },
        {
            "name": "Variable Parameter",
            "scope": "variable.parameter",
            "settings": {
                "foreground": "#AACCFF",
                "fontStyle": "italic"
            }
        },
        {
            "name": "Function",
            "scope": [
                "entity.name.function",
                "support.function"
            ],
            "settings": {
                "foreground": "#5588FF"
            }
        },
        {
            "name": "Class",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.class"
            ],
            "settings": {
                "foreground": "#FFD700",
                "fontStyle": "bold"
            }
        },
        {
            "name": "Interface",
            "scope": "entity.name.type.interface",
            "settings": {
                "foreground": "#AACCFF"
            }
        },
        {
            "name": "Type",
            "scope": [
                "support.type",
                "entity.name.type.parameter"
            ],
            "settings": {
                "foreground": "#00AACC"
            }
        },
        {
            "name": "Tag",
            "scope": [
                "entity.name.tag",
                "meta.tag"
            ],
            "settings": {
                "foreground": "#CC0000"
            }
        },
        {
            "name": "Attribute",
            "scope": [
                "entity.other.attribute-name"
            ],
            "settings": {
                "foreground": "#FFD700"
            }
        },
        {
            "name": "Property",
            "scope": [
                "variable.other.property",
                "support.type.property-name"
            ],
            "settings": {
                "foreground": "#88CCFF"
            }
        },
        {
            "name": "Namespace",
            "scope": "entity.name.namespace",
            "settings": {
                "foreground": "#AA88FF"
            }
        },
        {
            "name": "Decorator",
            "scope": [
                "meta.decorator",
                "punctuation.decorator"
            ],
            "settings": {
                "foreground": "#FF8844"
            }
        },
        {
            "name": "Import",
            "scope": [
                "meta.import",
                "keyword.control.import",
                "keyword.control.from"
            ],
            "settings": {
                "foreground": "#0088FF"
            }
        },
        {
            "name": "Regex",
            "scope": "string.regexp",
            "settings": {
                "foreground": "#FFAA55"
            }
        },
        {
            "name": "Punctuation",
            "scope": [
                "punctuation",
                "meta.brace"
            ],
            "settings": {
                "foreground": "#8EACFF"
            }
        },
        {
            "name": "Markup Heading",
            "scope": [
                "markup.heading",
                "entity.name.section"
            ],
            "settings": {
                "foreground": "#FFD700",
                "fontStyle": "bold"
            }
        },
        {
            "name": "Markup Bold",
            "scope": "markup.bold",
            "settings": {
                "foreground": "#FF8844",
                "fontStyle": "bold"
            }
        },
        {
            "name": "Markup Italic",
            "scope": "markup.italic",
            "settings": {
                "foreground": "#AACCFF",
                "fontStyle": "italic"
            }
        },
        {
            "name": "Markup Code",
            "scope": "markup.inline.raw",
            "settings": {
                "foreground": "#88CC88"
            }
        },
        {
            "name": "Markup Link",
            "scope": [
                "markup.underline.link",
                "string.other.link"
            ],
            "settings": {
                "foreground": "#5588FF"
            }
        },
        {
            "name": "Diff Inserted",
            "scope": "markup.inserted",
            "settings": {
                "foreground": "#4EC94E"
            }
        },
        {
            "name": "Diff Deleted",
            "scope": "markup.deleted",
            "settings": {
                "foreground": "#CC0000"
            }
        },
        {
            "name": "Diff Changed",
            "scope": "markup.changed",
            "settings": {
                "foreground": "#FFD700"
            }
        },
        {
            "name": "JSON Key",
            "scope": [
                "support.type.property-name.json"
            ],
            "settings": {
                "foreground": "#5588FF"
            }
        },
        {
            "name": "CSS Property",
            "scope": "support.type.property-name.css",
            "settings": {
                "foreground": "#88CCFF"
            }
        },
        {
            "name": "CSS Class",
            "scope": "entity.other.attribute-name.class.css",
            "settings": {
                "foreground": "#FFD700"
            }
        },
        {
            "name": "CSS ID",
            "scope": "entity.other.attribute-name.id.css",
            "settings": {
                "foreground": "#FF8844"
            }
        },
        {
            "name": "Invalid",
            "scope": "invalid",
            "settings": {
                "foreground": "#FF5555",
                "fontStyle": "strikethrough"
            }
        }
    ]
}