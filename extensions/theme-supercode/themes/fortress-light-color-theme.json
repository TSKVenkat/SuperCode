    "tokenColors": [
        {
            "settings": {
                "foreground": "#1A3050"
            }
        },
        {
            "name": "Comment",
            "scope": "comment",
            "settings": {
                "fontStyle": "italic",
                "foreground": "#6699CC"
            }
        },
        {
            "name": "Keyword",
            "scope": [
                "keyword",
                "storage.type",
                "storage.modifier"
            ],
            "settings": {
                "foreground": "#CC0000",
                "fontStyle": "bold"
            }
        },
        {
            "name": "Operator",
            "scope": "keyword.operator",
            "settings": {
                "foreground": "#0033AA"
            }
        },
        {
            "name": "String",
            "scope": "string",
            "settings": {
                "foreground": "#228822"
            }
        },
        {
            "name": "String Escape",
            "scope": [
                "constant.character.escape",
                "string constant"
            ],
            "settings": {
                "foreground": "#449944"
            }
        },
        {
            "name": "Number",
            "scope": [
                "constant.numeric",
                "constant.language"
            ],
            "settings": {
                "foreground": "#AA6600"
            }
        },
        {
            "name": "Constant",
            "scope": "constant",
            "settings": {
                "foreground": "#CC4400"
            }
        },
        {
            "name": "Variable",
            "scope": [
                "variable",
                "variable.other"
            ],
            "settings": {
                "foreground": "#1A3050"
            }
        },
        {
            "name": "Variable Parameter",
            "scope": "variable.parameter",
            "settings": {
                "foreground": "#336699",
                "fontStyle": "italic"
            }
        },
        {
            "name": "Function",
            "scope": [
                "entity.name.function",
                "support.function"
            ],
            "settings": {
                "foreground": "#0055AA"
            }
        },
        {
            "name": "Class",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.class"
            ],
            "settings": {
                "foreground": "#0033AA",
                "fontStyle": "bold"
            }
        },
        {
            "name": "Interface",
            "scope": "entity.name.type.interface",
            "settings": {
                "foreground": "#336699"
            }
        },
        {
            "name": "Type",
            "scope": [
                "support.type",
                "entity.name.type.parameter"
            ],
            "settings": {
                "foreground": "#0088AA"
            }
        },
        {
            "name": "Tag",
            "scope": [
                "entity.name.tag",
                "meta.tag"
            ],
            "settings": {
                "foreground": "#CC0000"
            }
        },
        {
            "name": "Attribute",
            "scope": [
                "entity.other.attribute-name"
            ],
            "settings": {
                "foreground": "#AA6600"
            }
        },
        {
            "name": "Property",
            "scope": [
                "variable.other.property",
                "support.type.property-name"
            ],
            "settings": {
                "foreground": "#336699"
            }
        },
        {
            "name": "Namespace",
            "scope": "entity.name.namespace",
            "settings": {
                "foreground": "#6644AA"
            }
        },
        {
            "name": "Decorator",
            "scope": [
                "meta.decorator",
                "punctuation.decorator"
            ],
            "settings": {
                "foreground": "#CC4400"
            }
        },
        {
            "name": "Import",
            "scope": [
                "meta.import",
                "keyword.control.import",
                "keyword.control.from"
            ],
            "settings": {
                "foreground": "#0055AA"
            }
        },
        {
            "name": "Regex",
            "scope": "string.regexp",
            "settings": {
                "foreground": "#CC6600"
            }
        },
        {
            "name": "Punctuation",
            "scope": [
                "punctuation",
                "meta.brace"
            ],
            "settings": {
                "foreground": "#4A6A8A"
            }
        },
        {
            "name": "Markup Heading",
            "scope": [
                "markup.heading",
                "entity.name.section"
            ],
            "settings": {
                "foreground": "#0033AA",
                "fontStyle": "bold"
            }
        },
        {
            "name": "Markup Bold",
            "scope": "markup.bold",
            "settings": {
                "foreground": "#CC4400",
                "fontStyle": "bold"
            }
        },
        {
            "name": "Markup Italic",
            "scope": "markup.italic",
            "settings": {
                "foreground": "#336699",
                "fontStyle": "italic"
            }
        },
        {
            "name": "Markup Code",
            "scope": "markup.inline.raw",
            "settings": {
                "foreground": "#228822"
            }
        },
        {
            "name": "Markup Link",
            "scope": [
                "markup.underline.link",
                "string.other.link"
            ],
            "settings": {
                "foreground": "#0055AA"
            }
        },
        {
            "name": "Diff Inserted",
            "scope": "markup.inserted",
            "settings": {
                "foreground": "#22AA22"
            }
        },
        {
            "name": "Diff Deleted",
            "scope": "markup.deleted",
            "settings": {
                "foreground": "#CC0000"
            }
        },
        {
            "name": "Diff Changed",
            "scope": "markup.changed",
            "settings": {
                "foreground": "#AA6600"
            }
        },
        {
            "name": "JSON Key",
            "scope": [
                "support.type.property-name.json"
            ],
            "settings": {
                "foreground": "#0055AA"
            }
        },
        {
            "name": "CSS Property",
            "scope": "support.type.property-name.css",
            "settings": {
                "foreground": "#336699"
            }
        },
        {
            "name": "CSS Class",
            "scope": "entity.other.attribute-name.class.css",
            "settings": {
                "foreground": "#AA6600"
            }
        },
        {
            "name": "CSS ID",
            "scope": "entity.other.attribute-name.id.css",
            "settings": {
                "foreground": "#CC4400"
            }
        },
        {
            "name": "Invalid",
            "scope": "invalid",
            "settings": {
                "foreground": "#CC0000",
                "fontStyle": "strikethrough"
            }
        }
    ]
}