{
    "name": "theme-supercode",
    "displayName": "SuperCode Themes",
    "description": "Superman-themed color themes for SuperCode IDE",
    "version": "1.0.0",
    "publisher": "supercode",
    "license": "MIT",
    "engines": {
        "vscode": "*"
    },
    "categories": [
        "Themes"
    ],
    "contributes": {
        "themes": [
            {
                "id": "Krypton Dark",
                "label": "Krypton Dark",
                "uiTheme": "vs-dark",
                "path": "./themes/krypton-dark-color-theme.json"
            },
            {
                "id": "Fortress of Solitude",
                "label": "Fortress of Solitude",
                "uiTheme": "vs",
                "path": "./themes/fortress-light-color-theme.json"
            }
        ]
    },
    "configurationDefaults": {
        "workbench.colorTheme": "Krypton Dark",
        "workbench.iconTheme": "vs-seti",
        "editor.fontFamily": "'JetBrains Mono', 'Fira Code', 'Cascadia Code', 'Consolas', monospace",
        "editor.fontSize": 14,
        "editor.fontLigatures": true,
        "editor.cursorBlinking": "smooth",
        "editor.smoothScrolling": true,
        "workbench.startupEditor": "welcomePage",
        "terminal.integrated.fontFamily": "'JetBrains Mono', 'Fira Code', monospace"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/supercode-ide/supercode.git"
    }
}