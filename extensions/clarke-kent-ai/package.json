{
    "name": "clarke-kent-ai",
    "displayName": "Clarke Kent AI",
    "description": "Superman's AI assistant for SuperCode - powered by OpenRouter with FREE models",
    "version": "1.0.0",
    "publisher": "supercode",
    "engines": {
        "vscode": "^1.90.0"
    },
    "categories": [
        "Machine Learning",
        "Programming Languages",
        "Other"
    ],
    "activationEvents": [
        "onStartupFinished"
    ],
    "icon": "media/image.png",
    "main": "./out/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "clarkeKent.setApiKey",
                "title": "Clarke Kent: Set OpenRouter API Key",
                "icon": "$(key)"
            },
            {
                "command": "clarkeKent.selectModel",
                "title": "Clarke Kent: Select AI Model",
                "icon": "$(hubot)"
            },
            {
                "command": "clarkeKent.chat",
                "title": "Clarke Kent: Ask a Question",
                "icon": "$(comment)"
            },
            {
                "command": "clarkeKent.explainCode",
                "title": "Clarke Kent: Explain Code",
                "icon": "$(book)"
            },
            {
                "command": "clarkeKent.fixCode",
                "title": "Clarke Kent: Fix Code",
                "icon": "$(wrench)"
            }
        ],
        "menus": {
            "editor/context": [
                {
                    "command": "clarkeKent.explainCode",
                    "group": "clarkeKent",
                    "when": "editorHasSelection"
                },
                {
                    "command": "clarkeKent.fixCode",
                    "group": "clarkeKent",
                    "when": "editorHasSelection"
                }
            ]
        },
        "keybindings": [
            {
                "command": "clarkeKent.chat",
                "key": "ctrl+shift+k",
                "mac": "cmd+shift+k"
            },
            {
                "command": "clarkeKent.explainCode",
                "key": "ctrl+shift+e",
                "mac": "cmd+shift+e",
                "when": "editorTextFocus"
            }
        ],
        "configuration": {
            "title": "Clarke Kent AI",
            "properties": {
                "clarkeKent.defaultModel": {
                    "type": "string",
                    "default": "qwen/qwen-2.5-72b-instruct:free",
                    "description": "Default AI model to use",
                    "enum": [
                        "qwen/qwen-2.5-72b-instruct:free",
                        "qwen/qwen-2.5-coder-32b-instruct:free",
                        "deepseek/deepseek-r1:free",
                        "deepseek/deepseek-chat:free",
                        "nvidia/llama-3.1-nemotron-70b-instruct:free",
                        "meta-llama/llama-3.3-70b-instruct:free"
                    ],
                    "enumDescriptions": [
                        "Qwen 2.5 72B - Powerful open-source model",
                        "Qwen 2.5 Coder 32B - Specialized for coding",
                        "DeepSeek R1 - Reasoning-focused model",
                        "DeepSeek Chat - General purpose AI",
                        "Nemotron 70B - NVIDIA high quality",
                        "Llama 3.3 70B - Latest Llama model"
                    ]
                }
            }
        }
    },
    "scripts": {
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./"
    },
    "devDependencies": {
        "@types/vscode": "^1.90.0",
        "typescript": "^5.0.0"
    }
}