{
    "name": "clarke-kent-ai",
    "displayName": "Clarke Kent AI",
    "description": "Superman's AI assistant for SuperCode - powered by OpenRouter",
    "version": "1.0.0",
    "publisher": "supercode",
    "engines": {
        "vscode": "^1.90.0"
    },
    "categories": [
        "AI",
        "Chat"
    ],
    "activationEvents": [
        "onStartupFinished"
    ],
    "icon": "media/image.png",
    "main": "./out/extension.js",
    "contributes": {
        "chatParticipants": [
            {
                "id": "clarkeKent",
                "name": "clarke",
                "fullName": "Clarke Kent",
                "description": "Your Superman AI coding assistant",
                "isDefault": true
            }
        ],
        "commands": [
            {
                "command": "clarkeKent.setApiKey",
                "title": "Clarke Kent: Set OpenRouter API Key"
            },
            {
                "command": "clarkeKent.selectModel",
                "title": "Clarke Kent: Select AI Model"
            },
            {
                "command": "clarkeKent.previewFile",
                "title": "Clarke Kent: Preview Current File",
                "icon": "$(open-preview)"
            },
            {
                "command": "clarkeKent.runFile",
                "title": "Clarke Kent: Run Current File",
                "icon": "$(play)"
            },
            {
                "command": "clarkeKent.stopExecution",
                "title": "Clarke Kent: Stop Execution",
                "icon": "$(debug-stop)"
            },
            {
                "command": "clarkeKent.analyzeError",
                "title": "Clarke Kent: Analyze Errors in Current File",
                "icon": "$(bug)"
            },
            {
                "command": "clarkeKent.generateProject",
                "title": "Clarke Kent: Generate New Project",
                "icon": "$(folder-library)"
            }
        ],
        "keybindings": [
            {
                "command": "clarkeKent.previewFile",
                "key": "ctrl+shift+v",
                "when": "editorTextFocus"
            },
            {
                "command": "clarkeKent.runFile",
                "key": "f5",
                "when": "editorTextFocus && !inDebugMode"
            }
        ],
        "configuration": {
            "title": "Clarke Kent AI",
            "properties": {
                "clarkeKent.model": {
                    "type": "string",
                    "default": "anthropic/claude-3.5-sonnet",
                    "description": "The AI model to use for Clarke Kent",
                    "enum": [
                        "anthropic/claude-3.5-sonnet",
                        "anthropic/claude-3-opus",
                        "openai/gpt-4o",
                        "openai/gpt-4-turbo",
                        "google/gemini-pro-1.5",
                        "meta-llama/llama-3.1-70b-instruct"
                    ]
                },
                "clarkeKent.runConfigurations": {
                    "type": "object",
                    "default": {
                        "python": "python3 ${file}",
                        "javascript": "node ${file}",
                        "typescript": "npx ts-node ${file}",
                        "go": "go run ${file}",
                        "rust": "cargo run",
                        "java": "java ${fileBasenameNoExtension}",
                        "c": "gcc ${file} -o ${fileBasenameNoExtension} && ./${fileBasenameNoExtension}",
                        "cpp": "g++ ${file} -o ${fileBasenameNoExtension} && ./${fileBasenameNoExtension}"
                    },
                    "description": "Language-specific run commands. Use ${file}, ${fileBasename}, ${fileBasenameNoExtension}, ${fileDirname}"
                }
            }
        }
    },
    "scripts": {
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./"
    },
    "dependencies": {
        "axios": "^1.6.0"
    },
    "devDependencies": {
        "@types/vscode": "^1.90.0",
        "typescript": "^5.0.0"
    }
}